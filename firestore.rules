rules_version = '2';

// TEMPORARY SAFE DEFAULT.
// These rules intentionally deny all client access until Firebase
// Authentication and role-based authorization are implemented.
// Do not deploy as production rules while the apps require Firestore access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
