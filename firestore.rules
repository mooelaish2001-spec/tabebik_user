rules_version = '2';

// TEMPORARY SAFE DEFAULT.
// These rules intentionally deny all client access until the Firebase
// Authentication model and per-role authorization rules are implemented.
// Do not deploy as production rules if the apps are expected to read/write Firestore.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
