rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function phoneNumber() {
      return signedIn()
        ? request.auth.token.get('accountPhone', request.auth.token.get('phone_number', null))
        : null;
    }

    function centerMember(centerId) {
      return signedIn()
        && phoneNumber() != null
        && firestore.exists(/databases/(default)/documents/centerMembers/$(phoneNumber()))
        && firestore.get(/databases/(default)/documents/centerMembers/$(phoneNumber())).data.centerId == centerId
        && firestore.get(/databases/(default)/documents/centerMembers/$(phoneNumber())).data.active == true
        && firestore.get(/databases/(default)/documents/centerMembers/$(phoneNumber())).data.uid == request.auth.uid;
    }

    function centerManager(centerId) {
      return centerMember(centerId)
        && firestore.get(/databases/(default)/documents/centerMembers/$(phoneNumber())).data.role == 0;
    }

    function booking(bid) {
      return firestore.get(/databases/(default)/documents/bookings/$(bid)).data;
    }

    function imageUpload() {
      return request.resource != null
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /receipts/{bookingId}/{fileName} {
      allow write: if signedIn()
        && imageUpload()
        && booking(bookingId).patientUid == request.auth.uid;

      allow read: if signedIn() && (
        booking(bookingId).patientUid == request.auth.uid
        || (booking(bookingId).centerId is string && centerMember(booking(bookingId).centerId))
      );
    }

    match /licenses/{centerId}/{fileName} {
      allow write: if centerManager(centerId) && imageUpload();
      allow read: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}